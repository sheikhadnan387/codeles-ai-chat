DATABASE_URL="postgresql://user:password@localhost:5432/codeles_ai?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o-mini"
AI_SYSTEM_PROMPT="You are Codeles AI, an intelligent AI assistant. Provide accurate, practical and concise answers while expanding when the user asks for detail."
# Optional - number of most recent messages (oldest-first) sent to the model as context. Defaults to 20.
AI_MAX_CONTEXT_MESSAGES=20
FRONTEND_URL="http://localhost:3000"
PORT=4000
